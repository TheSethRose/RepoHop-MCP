{
	"name": "repohop-mcp-client",
	"version": "0.1.0",
	"description": "Template MCP client for RepoHop: OAuth 2.1, typed project_* tools, approval hooks. Copy this repo to give any bot safe access to a RepoHop canonical checkout.",
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.3.13",
	"bin": {
		"repohop-mcp": "./dist/cli.js"
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "bun build ./src/cli.ts --outdir ./dist --target node --format esm --external:@modelcontextprotocol/* --external:zod",
		"type-check": "tsc --noEmit",
		"lint": "biome lint .",
		"format:check": "biome format .",
		"test": "bun test test/unit",
		"test:compat": "bun test test/compat",
		"verify": "bun run lint && bun run type-check && bun run test"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "2.0.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@types/bun": "latest",
		"typescript": "^5.9.2"
	},
	"testedServers": {
		"repohop": ">=0.1.0",
		"mcpProtocol": "2025-11-25",
		"sdk": "@modelcontextprotocol/client@2.0.0"
	}
}
